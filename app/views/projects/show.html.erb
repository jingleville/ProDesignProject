<div class="mb-6">
  <div class="flex justify-between items-start">
    <div>
      <h1 class="text-2xl font-bold"><%= @project.name %></h1>
      <p class="text-gray-600 mt-1"><%= @project.description %></p>
      <div class="mt-2 flex items-center space-x-4 text-sm text-gray-500">
        <%= render partial: "projects/status_badge", locals: { status: @project.status } %>
        <span>Автор: <%= @project.creator.full_name %></span>
        <span><%= @project.created_at.strftime("%d.%m.%Y") %></span>
      </div>
    </div>
    <div class="flex space-x-2">
      <% if policy(@project).update? %>
        <%= link_to "Редактировать", edit_project_path(@project), class: "bg-gray-200 text-gray-700 px-3 py-2 rounded-md hover:bg-gray-300 text-sm" %>
      <% end %>
      <%= link_to "Гант", gantt_project_path(@project), class: "bg-indigo-100 text-indigo-700 px-3 py-2 rounded-md hover:bg-indigo-200 text-sm" %>
    </div>
  </div>
</div>

<%# ---- Этапы ---- %>
<% if @stages.any? %>
  <% @stages.each do |stage| %>
    <div class="mb-6">
      <div class="flex justify-between items-center mb-2">
        <h2 class="text-lg font-semibold"><%= stage.name %></h2>
        <span class="text-sm text-gray-500">Выполнено: <%= stage.completion_percentage %>%</span>
      </div>
      <div class="w-full bg-gray-200 rounded-full h-2 mb-3">
        <div class="bg-indigo-600 h-2 rounded-full" style="width: <%= stage.completion_percentage %>%"></div>
      </div>
      <%= render partial: "projects/tasks_table", locals: { tasks: stage.tasks, project: @project } %>
    </div>
  <% end %>
<% end %>

<%# ---- Задачи без этапа ---- %>
<div class="flex justify-between items-center mb-4">
  <h2 class="text-lg font-semibold"><%= @stages.any? ? "Задачи без этапа" : "Задачи" %></h2>
  <% if policy(Task).create? %>
    <%= link_to "Новая задача", new_project_task_path(@project),
          class: "bg-indigo-600 text-white px-3 py-2 rounded-md hover:bg-indigo-700 text-sm" %>
  <% end %>
</div>
<%= render partial: "projects/tasks_table", locals: { tasks: @tasks, project: @project } %>

<%# ---- Смета проекта ---- %>
<% if policy(EstimateItem).index? %>
  <div class="mt-8 bg-white shadow rounded-lg p-6">
    <div class="flex justify-between items-center mb-4">
      <h2 class="text-lg font-semibold">Смета проекта</h2>
    </div>
    <% if @project.estimate_items.any? %>
      <table class="min-w-full divide-y divide-gray-200 mb-4">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Позиция</th>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Кол-во</th>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Цена</th>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Итого</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% @project.estimate_items.each do |item| %>
            <tr>
              <td class="px-4 py-2 text-sm"><%= item.name %></td>
              <td class="px-4 py-2 text-sm"><%= item.quantity %></td>
              <td class="px-4 py-2 text-sm"><%= item.unit_price %></td>
              <td class="px-4 py-2 text-sm font-medium"><%= "%.2f" % item.total_price %></td>
            </tr>
          <% end %>
        </tbody>
        <tfoot class="bg-gray-50">
          <tr>
            <td colspan="3" class="px-4 py-2 text-sm font-semibold text-right">Итого:</td>
            <td class="px-4 py-2 text-sm font-bold">
              <%= "%.2f" % @project.estimate_items.sum { |i| i.total_price } %>
            </td>
          </tr>
        </tfoot>
      </table>
    <% else %>
      <p class="text-gray-500 text-sm">Позиции сметы не добавлены.</p>
    <% end %>
  </div>
<% end %>
