<%
  colors = {
    "draft"                => "bg-gray-100 text-gray-800",
    "awaiting_approval"    => "bg-yellow-100 text-yellow-800",
    "approved"             => "bg-blue-100 text-blue-800",
    "in_progress"          => "bg-purple-100 text-purple-800",
    "pending_confirmation" => "bg-orange-100 text-orange-800",
    "completed"            => "bg-green-100 text-green-800",
    "cancelled"            => "bg-red-100 text-red-800"
  }
  labels = {
    "draft"                => "Черновик",
    "awaiting_approval"    => "На согласовании",
    "approved"             => "Согласована",
    "in_progress"          => "В работе",
    "pending_confirmation" => "На подтверждении",
    "completed"            => "Завершена",
    "cancelled"            => "Отменена"
  }
%>
<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= colors[status] || 'bg-gray-100 text-gray-800' %>">
  <%= labels[status] || status.humanize %>
</span>
